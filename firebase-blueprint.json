{
  "entities": {
    "DeliveryItem": {
      "title": "Delivery Item",
      "description": "A shared package delivery destination synced in real time across all active drivers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "originalNumber": { "type": "number" },
        "address": { "type": "string", "maxLength": 500 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "hasLocation": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "in_transit", "delivered", "failed"] },
        "coverageStatus": { "type": "string", "enum": ["in_coverage", "out_of_coverage", "incomplete", "pending_validation"] },
        "province": { "type": "string", "maxLength": 100 },
        "recipientName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 },
        "failureReason": { "type": "string", "maxLength": 300 },
        "orderIndex": { "type": "number" },
        "distanceFromPrevKm": { "type": "number" },
        "estimatedMinutes": { "type": "number" },
        "assignedDriverId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedDriverName": { "type": "string", "maxLength": 100 },
        "deliveryPhoto": { "type": "string", "maxLength": 600000 },
        "deliveryPhotoAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "originalNumber", "address", "lat", "lng", "status", "coverageStatus", "orderIndex", "assignedDriverId", "createdAt", "updatedAt"]
    },
    "DriverProfile": {
      "title": "Driver Profile",
      "description": "An active registered driver profile (name-based, no Google login required; removable when no longer working)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "driverName": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "driverName", "active", "createdAt", "updatedAt"]
    },
    "RouteSession": {
      "title": "Route Session",
      "description": "A saved route session shared across all active drivers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "paused", "completed", "saved"] },
        "totalDistanceKm": { "type": "number" },
        "totalMinutes": { "type": "number" },
        "createdAt": { "type": "number" },
        "items": { "type": "array" }
      },
      "required": ["id", "ownerId", "name", "date", "status", "createdAt"]
    }
  },
  "firestore": {
    "/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/DeliveryItem" },
      "description": "Shared fleet delivery packages accessible and editable by all active drivers"
    },
    "/drivers/{driverId}": {
      "schema": { "$ref": "#/entities/DriverProfile" },
      "description": "Active driver roster; deleting a driver revokes their sync access"
    },
    "/routes/{routeId}": {
      "schema": { "$ref": "#/entities/RouteSession" },
      "description": "Shared saved route sessions accessible by all active drivers"
    }
  }
}
